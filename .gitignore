# Dependencies and build output
node_modules/
.pnp
.pnp.js
.next/
out/
build/
dist/
*.tsbuildinfo
# Next.js 在 dev / build 时自动生成，不是源码（create-next-app 默认也忽略它）。
# 不写这行它就会一直以「未跟踪」出现在 git status 里。
next-env.d.ts

# Local environment and credentials
.env*
!.env.example
!.env.production.example
*.pem

# Logs and OS files
*-debug.log*
.DS_Store
Thumbs.db

# Tool-generated local state
/.workbuddy/
/.codegraph/
/.ua/
/.codex/
/.yanagent/
/.vercel/
/.worktrees/

# agent 会话工作目录（`<日期>-<会话号>`，内含任务注册表与产物快照）。
# 与上面那几个同类：本机专用、换台机器就没用，且可能含未定稿的私人材料
# （例如发布文案草稿）。不锚定的话 `git add -A` 会把它们一起推上公开仓库。
/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-*/

# Local previews, runtime data and private notes
/design-system-preview.html
/game-design-preview.html
/data/
/work/
/work-verify/
/exports/
/.private/
/docs/
/产品说明计划书.md
/黑客松规则.txt
/草稿*.txt
/AGENTS.md
.test-stats-raw.json
