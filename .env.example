# AI 地下城主（AI DM）配置
#
# 推荐组合：DeepSeek 出关卡/处境/报告 + 知乎搜索出真实语料。
# 两者都不配时，自由推演会自动走离线剧本兜底，演示不会白屏。

# ── 模型（推荐 DeepSeek）─────────────────────────────────────
# 支持 json_object 结构化输出、指令服从度高、比直答快得多。
DM_API_KEY=
DM_BASE_URL=https://api.deepseek.com/v1
DM_MODEL=deepseek-chat
# 需要回复更快、更便宜时可用 deepseek-chat 的默认档；不要用推理档（长工具循环里易漂移）

# 是否要求结构化输出（response_format: json_object）。
# 个别中转端点不支持时设为 false，解析层仍会容错。
DM_JSON_MODE=true

# 单次生成超时（毫秒），超时后自动降级
DM_TIMEOUT_MS=30000

# 采样参数
DM_TEMPERATURE=0.85
DM_MAX_TOKENS=1400

# ── 知乎开放平台（真实语料来源）───────────────────────────────
# 在 https://developer.zhihu.com/profile 获取 Access Secret。
# 配了它，溯源角标会显示真实的答主、赞同数与原回答链接。
ZHIHU_ACCESS_SECRET=
# 可选：搜索缓存 TTL（毫秒），默认 10 分钟，用于保护 1000 次/天的配额
ZHIHU_CACHE_TTL_MS=600000

# 可选：故事接口路径。规则页未公开该路径，不同租户可能不同；
# 默认值按开放平台惯例，调用失败会自动降级，不影响其他能力。
ZHIHU_STORY_PATH=/api/v1/content/story

# 说明：知乎直答（zhida-*）不支持结构化输出、实测会把 JSON 指令写成长文，
# 已从模型链路移除；知乎开放平台现在只用于搜索。

# ── 知乎账号登录（OAuth）─────────────────────────────────────
# 三类凭证必须分开，切勿串位（App ID / OAuth App Key / Access Secret）。
#
# App ID：短数字，来自开放平台应用详情页。
# 只在服务端读取，不会下发到浏览器。
ZHIHU_OAUTH_APP_ID=

# OAuth App Key：用于 /access_token 换取用户令牌。
# 这是「OAuth App Key」，不是下面的 Access Secret，也不是 App ID。
ZHIHU_OAUTH_APP_KEY=

# 公网 HTTPS 回调地址，须与开放平台登记值完全一致（含路径与尾部斜杠）。
# 本地 127.0.0.1 / localhost 无法完成真实登录，只能预览授权页。
# 形如：https://your-app.example.com/auth/callback
ZHIHU_OAUTH_REDIRECT_URI=

# 调试开关：给 /api/dm 注入人工延迟（毫秒），用于验证网络延迟期间的加载动效。
# 生产环境请保持为空或 0。
DM_DEBUG_DELAY_MS=
