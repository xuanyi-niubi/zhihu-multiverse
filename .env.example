# 知乎平行宇宙 · 环境变量（开发/本地）
#
# 用法：
#   cp .env.example .env.local
#   # 直接留空也能跑：没有 App 能力时自动走离线剧本 + 已落盘的真实来源快照。
#
# ---------------------------------------------------------------------------
# 本文件与世界的关系（05_AGENT §14 / §15）
#
#   A. Public App Runtime —— 部署者填一次，**所有访客打开即用**，不需要任何 Key。
#   B. 知乎账号登录（OAuth）—— 可选，用来把记忆绑定到真实账号。
#   C. Advanced / legacy —— 主链不再读取的历史配置，与档位名覆盖。
#   D. 存储与运维 —— 可选，容器里由挂载卷决定。
#
# 两类"用户自带"的凭据**不在这里填**：
#   访客自己的模型 Key / 知乎 Secret 在应用内 `/settings` 里填，
#   落服务器磁盘（0600）并按匿名 cookie 或知乎账号隔离。
#   解析优先级恒为：用户自带 > App（APP_*）> none（离线兜底）。
#
# ⚠️ APP_* 只在服务端读取，绝不下发浏览器（src/config/serverEnv.ts 有运行期闸门）。
# ---------------------------------------------------------------------------

# ===========================================================================
# A. Public App Runtime（推荐：先配这一段，公开版就"打开即用"）
# ===========================================================================
# 不配也不影响运行：自动走离线剧本 + 已落盘的真实快照。
APP_LLM_API_KEY=
APP_LLM_BASE_URL=https://api.deepseek.com/v1
# 便宜档（理解 / 单幕叙事）；留空则跟随 DEEP 档。
APP_LLM_FAST_MODEL=
# 能力档（世界编译）；留空则跟随 FAST 档。
APP_LLM_DEEP_MODEL=
APP_ZHIHU_ACCESS_SECRET=
# 结构化输出（默认 true）。除非你的端点不支持 json_object，否则不要关：
# 关掉它主链的 JSON 解析会退到兜底，属于现场很难查的那类故障。
APP_LLM_JSON_MODE=true

# ---- App 能力的用量闸门（只对上面这份 App 能力生效）----------------------
# 原则：花服务器的钱才受限；用户填了自己的 Key 一律不受这些数字约束。
# 单局最多几次真正的模型调用（离线兜底不计）。超了只把这一回合降级成
# 离线叙事，不会中断这一局、也不会把站点打成 5xx。
APP_MAX_LLM_CALLS_PER_SESSION=5
# 每个身份每小时 / 每天最多开几局（按匿名 cookie 或登录身份计，不用 IP）。
APP_MAX_SESSIONS_PER_HOUR=5
APP_MAX_SESSIONS_PER_DAY=20
# 全站每天最多几次 App 模型调用（软上限）。用满只暂停 App 能力：
# 自带 Key 的访客照常，其余人走离线剧本 + 已落盘的真实快照。
APP_MAX_DAILY_LLM_CALLS=2000
# ---- IP 维度防刷闸（身份闸的兜底）-----------------------------------------
# 匿名 cookie 可以被刷子重置，IP 不能 —— 这两道闸防的是「清 cookie 无限开局」
# 与「脚本逐次白嫖 /api/dm、/api/profile 等不带会话的端点」。
# 默认值故意比身份闸宽：公司 / 校园网出口共用 IP 是正常情形，只拦明显不是人的量级。
# 前提：nginx 反代必须覆写 X-Forwarded-For / X-Real-IP（见 deploy 配置），
# 且容器端口不直接对公网暴露，否则客户端可以伪造 IP 头绕过。
APP_MAX_SESSIONS_PER_IP_HOUR=10
APP_MAX_LLM_CALLS_PER_IP_HOUR=30

# ===========================================================================
# B. 知乎账号登录（OAuth）—— 可选
# ===========================================================================
# 三类凭证必须分开，切勿串位（App ID / OAuth App Key / Access Secret）。
#
# App ID：短数字，来自开放平台应用详情页。只在服务端读取。
ZHIHU_OAUTH_APP_ID=
# OAuth App Key：用于 /access_token 换取用户令牌（不是 Access Secret，也不是 App ID）。
ZHIHU_OAUTH_APP_KEY=
# 公网 HTTPS 回调地址，须与开放平台登记值完全一致（含路径与尾部斜杠）。
# 本地 127.0.0.1 / localhost 无法完成真实登录，只能预览授权页。
# 形如：https://your-app.example.com/auth/callback
ZHIHU_OAUTH_REDIRECT_URI=

# 对外可见的来源（协议 + 域名 + 端口，不带尾斜杠）。
# 只在「反向代理 + 容器」部署时需要：容器的 request.url 是自己的
# 0.0.0.0:PORT，用它做跳转会得到一个打不开的地址。
# 本地开发不用填。
# 形如：https://your-app.example.com
# APP_PUBLIC_ORIGIN=

# ===========================================================================
# C. Advanced / legacy
# ===========================================================================
# C1. 档位名覆盖（生效）：DM_* 的档位名优先于 APP_LLM_*_MODEL。
#     只在你想显式钉住模型名时才用；不填就跟随 APP_LLM_FAST_MODEL / APP_LLM_DEEP_MODEL。
DM_MODEL=
DM_FAST_MODEL=
DM_DEEP_MODEL=

# C2. 主链已不再读取的历史配置（保留仅为兼容旧部署与 legacy 解析器）。
#     新部署不要依赖它们：模型走 APP_LLM_* 或访客自带的 /settings，
#     知乎检索走 APP_ZHIHU_ACCESS_SECRET 或访客自带的 /settings。
# DM_API_KEY=
# OPENAI_API_KEY=
# DM_BASE_URL=
# DM_JSON_MODE=
# DM_TIMEOUT_MS=
# DM_TEMPERATURE=
# DM_MAX_TOKENS=
# ZHIHU_ACCESS_SECRET=      # 仅 OAuth 凭证诊断与 legacy 解析器读取
# ZHIHU_API_KEY=
# ZHIHU_ACCESS_TOKEN=
# ZHIHU_BASE_URL=
# ZHIHU_CACHE_TTL_MS=
# 每局知乎检索预算（条）：默认 8，硬上限 12。放宽它 = 用检索次数换覆盖面：
# 丢起点保目标 / 按层级分别放宽 / 年代查询 / 反例加厚。
# APP_MAX_SEARCH_REQUESTS=8
# 全站当日知乎检索总预算（条）：默认 900。用满**不报错**，只是停止检索并如实
# 标注「今天的检索额度已用完」——绝不把"没查"说成"没有人讨论"。
# APP_MAX_SEARCHES_PER_DAY=900
# ZHIHU_OAUTH_APPID=        # ZHIHU_OAUTH_APP_ID 的旧别名，仍在代码里兼容

# ===========================================================================
# D. 存储与运维（可选；容器里由挂载卷 / docker-compose 环境决定）
# ===========================================================================
# 下面这些目录默认都在 <项目>/data/ 下，容器里指向挂载卷（根文件系统只读）。
# MEMORY_DIR=./data/memory
# SETTINGS_DIR=./data/settings
# DECISION_SESSION_DIR=./data/decision-sessions
# REALITY_MEMORY_DIR=./data/reality-memory
# COMMITMENT_DIR=./data/commitments   # 缺省跟随 MEMORY_DIR 的同级目录
# EXPERIENCE_SEARCH_CACHE_DIR=./data/experience-search-cache
# 检索缓存 TTL（毫秒），默认 12 小时：重启不烧知乎配额。
# 判分 / 路演当天建议调到 48 小时（172800000），让重复访问零消耗。
# EXPERIENCE_SEARCH_CACHE_TTL_MS=43200000
# 结构化日志：置 off 关闭（测试里默认关闭）。
# OBSERVABILITY=on
# 调试开关：给 /api/dm 注入人工延迟（毫秒），验证网络延迟期间的加载动效。
# 生产环境请保持为空或 0。
DM_DEBUG_DELAY_MS=

# 站点公开地址。**只用于分享卡（Open Graph 封面）的绝对 URL 生成**，不影响运行。
# 不填会回落到 src/app/layout.tsx 里的默认值；换域名时改这里，不必动代码。
# 不配的后果很隐蔽：微信 / 飞书抓取分享链接时拿不到封面，退化成一条纯文字链接。
NEXT_PUBLIC_SITE_URL=https://zhihu.xuanyi888.cloud:8443
