# 知乎平行宇宙 · 生产环境变量
#
# 用法：
#   cp .env.production.example .env.production
#   # 填入真实值，然后
#   docker compose up -d --build
#
# ⚠️ .env.production 已被 .gitignore 与 .dockerignore 双重排除。
#    不要把它提交到仓库，也不要打进镜像。

# ===========================================================================
# 一、知乎账号登录（OAuth）—— 官方点名推荐，登录人数计入人气奖
# ===========================================================================
#
# 三类凭证必须分开，串位会导致登录失败（服务端会主动告警，见 /oauth 面板）：
#   App ID       短数字    → ZHIHU_OAUTH_APP_ID
#   OAuth App Key 长字符串 → ZHIHU_OAUTH_APP_KEY
#   Access Secret 长字符串 → ZHIHU_ACCESS_SECRET（与上面两个都不同）
# 申请入口：https://developer.zhihu.com （个人中心完成实名后创建 Web 应用）

ZHIHU_OAUTH_APP_ID=

# OAuth App Key：用于 /access_token 置换用户令牌
ZHIHU_OAUTH_APP_KEY=

# ⚠️ 必须与知乎开放平台登记的地址**完全一致**（含协议、域名、路径、尾部斜杠）。
# 部署后到 /oauth 面板可看到当前生效值与是否通过校验。
# 形如：https://your-domain.com/auth/callback
ZHIHU_OAUTH_REDIRECT_URI=

# ===========================================================================
# 二、知乎开放平台（搜索 / 热榜 / 故事）
# ===========================================================================
# 用于 AI DM 的真实语料 grounding、首页今日热榜，以及用户数据接口鉴权。
# 不配也能跑：AI DM 会自动走离线编剧兜底，演示不白屏。
ZHIHU_ACCESS_SECRET=

# 搜索缓存 TTL（毫秒），保护 1000 次/天配额。默认 10 分钟。
ZHIHU_CACHE_TTL_MS=600000

# 故事接口路径（规则页未公开，不同租户可能不同；调用失败会自动降级）
ZHIHU_STORY_PATH=/api/v1/content/story

# ===========================================================================
# 三、AI 地下城主（模型）
# ===========================================================================
# 不配则全部走离线精调剧本 —— 演示零延迟、零成本、零翻车风险。
# 配了才能在玩家输入生僻目标时现场生成关卡（"万物皆可推演"）。
DM_API_KEY=
DM_BASE_URL=https://api.deepseek.com/v1
DM_MODEL=deepseek-chat
DM_JSON_MODE=true
DM_TIMEOUT_MS=30000
DM_TEMPERATURE=0.85
DM_MAX_TOKENS=1400

# 调试开关：给 /api/dm 注入人工延迟（毫秒），用于验证加载动效。
# **生产环境必须留空或 0。**
DM_DEBUG_DELAY_MS=
