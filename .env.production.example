# 知乎平行宇宙 · 生产环境变量
#
# 用法：
#   cp .env.production.example .env.production
#   # 填入真实值（通常只需要 A 段），然后
#   docker compose up -d --build
#
# ⚠️ .env.production 已被 .gitignore 与 .dockerignore 双重排除。
#    不要把它提交到仓库，也不要打进镜像。
#
# ---------------------------------------------------------------------------
# 公开比赛版的最小配置就是 A 段：配好 App 能力后，**评委不需要填任何 Key**。
#   A. Public App Runtime  —— 部署者填一次，所有访客打开即用（推荐只填这段）
#   B. 知乎账号登录（OAuth）—— 可选，登录人数计入人气奖
#   C. Advanced / legacy   —— 档位名覆盖 + 主链已不读取的历史配置
#
# 访客自己的模型 Key / 知乎 Secret **不在这里**：在应用内 `/settings` 填写，
# 只落服务器磁盘（0600），按匿名 cookie 或知乎账号隔离；
# 优先级恒为 用户自带 > App（APP_*）> none（离线兜底）。
#
# ⚠️ APP_* 只在服务端读取，绝不下发浏览器（src/config/serverEnv.ts 的运行期闸门）。
# ⚠️ App 能力受用量预算保护（src/core/usage/：每局调用上限 + 每身份局数上限），
#    用满只降级成离线叙事，不会把站点打成 5xx。
# ---------------------------------------------------------------------------

# ===========================================================================
# A. Public App Runtime（推荐先配这一段 —— 打开即用）
# ===========================================================================
# 不配也能跑：自动走离线剧本 + 已落盘的真实快照。
APP_LLM_API_KEY=
APP_LLM_BASE_URL=https://api.deepseek.com/v1
# 便宜档（理解 / 单幕叙事）；留空则跟随 DEEP 档。
APP_LLM_FAST_MODEL=
# 能力档（世界编译）；留空则跟随 FAST 档。
APP_LLM_DEEP_MODEL=
APP_ZHIHU_ACCESS_SECRET=
# 结构化输出（默认 true）。除非端点不支持 json_object，否则不要关。
APP_LLM_JSON_MODE=true

# ---- 用量闸门（只对上面这份 App 能力生效）--------------------------------
# 花服务器的钱才受限；用户填了自己的 Key 一律不受这些数字约束。
# 单局最多几次真正的模型调用（离线兜底不计）—— 超了降级离线，不报错。
APP_MAX_LLM_CALLS_PER_SESSION=5
# 每个身份每小时 / 每天最多开几局（按匿名 cookie 或登录身份计，不用 IP）。
APP_MAX_SESSIONS_PER_HOUR=5
APP_MAX_SESSIONS_PER_DAY=20
# 全站每天最多几次 App 模型调用（软上限）。用满只暂停 App 能力：
# 自带 Key 的访客照常，其余人走离线剧本 + 已落盘的真实快照。
APP_MAX_DAILY_LLM_CALLS=2000
# ---- IP 维度防刷闸（身份闸的兜底）-----------------------------------------
# 匿名 cookie 可以被刷子重置，IP 不能 —— 防「清 cookie 无限开局」与
# 「脚本逐次白嫖 /api/dm、/api/profile、/api/boss/evaluate 等端点」。
# 默认比身份闸宽：共用出口 IP（公司 / 校园网）是正常情形，只拦明显不是人的量级。
# ⚠️ 生效前提：反代（nginx）必须覆写 X-Forwarded-For / X-Real-IP，
#    且容器端口不直接对公网暴露 —— 否则客户端可伪造 IP 头绕过这道闸。
APP_MAX_SESSIONS_PER_IP_HOUR=10
APP_MAX_LLM_CALLS_PER_IP_HOUR=30

# ---- 知乎检索闸门（最稀缺的那一样；2026-09-16 新增）------------------------
# 模型调用有五道闸，而最稀缺的**知乎检索配额**此前只有「每局 ≤N 条」一个约束。
# 每局最多几条检索：默认 10（硬上限 12）。放宽它 = 用检索次数换覆盖面：
#   · 丢起点保目标（其他背景进入同一目标）
#   · 按相似层级分别放宽（同族 / 同域不再互相稀释）
#   · **两条**年代查询（往前 8 年 + 往前 5 年）—— 实测能把中位年份从 2025 拉回 2020，
#     直接决定「平行的时间」能不能成立（越早越好是错的：2012 那档明显退化）
#   · 反例加厚（失败/退出 与 后悔/劝退 分开问）
APP_MAX_SEARCH_REQUESTS=10
# 全站当天最多几条检索：默认 900。用满**不报错、不 5xx**，只是停止检索，
# 并把这一局如实标注成「今天的检索额度已用完」——
# 绝不把「我们没查」说成「没有人讨论」（这是这个产品最不能犯的错）。
APP_MAX_SEARCHES_PER_DAY=900
# 判分 / 路演当天建议：把检索缓存 TTL 调到 48 小时，让重复访问零消耗。
# EXPERIENCE_SEARCH_CACHE_TTL_MS=172800000

# ===========================================================================
# B. 知乎账号登录（OAuth）—— 可选，官方点名推荐
# ===========================================================================
# 三类凭证必须分开，串位会导致登录失败（服务端会主动告警，见 /oauth 面板）：
#   App ID        短数字    → ZHIHU_OAUTH_APP_ID
#   OAuth App Key 长字符串  → ZHIHU_OAUTH_APP_KEY
#   Access Secret 长字符串  → 见 C 段的 ZHIHU_ACCESS_SECRET（与上面两个都不同）
# 申请入口：https://developer.zhihu.com （个人中心完成实名后创建 Web 应用）
ZHIHU_OAUTH_APP_ID=

# OAuth App Key：用于 /access_token 置换用户令牌
ZHIHU_OAUTH_APP_KEY=

# ⚠️ 必须与知乎开放平台登记的地址**完全一致**（含协议、域名、路径、尾部斜杠）。
# 部署后到 /oauth 面板可看到当前生效值与是否通过校验。
# 形如：https://your-domain.com/auth/callback
ZHIHU_OAUTH_REDIRECT_URI=

# ---------------------------------------------------------------------------
# ⚠️ 反代部署必填：对外可见的来源（含端口）
#
# 为什么需要它：容器内的 Next standalone 用**自己的** HOSTNAME/PORT 拼
# `request.url`，通常是 `http://0.0.0.0:3000/...`。授权成功后若用
# `new URL(path, request.url)` 跳转，浏览器会被送到 `0.0.0.0:3000`
# —— 手机上是 ERR_CONNECTION_REFUSED，用户以为登录失败，其实已经成功了。
#
# 这个 bug 只在「反代 + 容器」下出现：本地 dev / 直连时 request.url
# 就是访问地址，怎么测都是对的。
#
# 填你对外访问的完整来源（协议 + 域名 + 端口，**不要**带尾斜杠）：
APP_PUBLIC_ORIGIN=https://your-domain.com

# 备用来源是反代传的 `x-forwarded-host`。若不方便设上一项，请确认反代传的是
# `$http_host`（含端口）而不是 `$host`（不含端口）——本站对外是 :8443，
# 丢端口会把用户送回 443。

# ===========================================================================
# C. Advanced / legacy
# ===========================================================================
# C1. 档位名覆盖（生效）：DM_* 的档位名优先于 APP_LLM_*_MODEL。
#     不填就跟随 APP_LLM_FAST_MODEL / APP_LLM_DEEP_MODEL。
DM_MODEL=
DM_FAST_MODEL=
DM_DEEP_MODEL=

# C2. 自托管专用（按需）：OAuth 面板的凭证诊断与 legacy 解析器会读这一项。
#     主链的知乎检索不走它 —— 那条路走 APP_ZHIHU_ACCESS_SECRET（A 段）
#     或访客自己在 /settings 填的 Secret。
# ZHIHU_ACCESS_SECRET=

# C3. 主链已不再读取的历史配置。保留仅为兼容旧部署；新部署不要依赖。
# DM_API_KEY=
# OPENAI_API_KEY=
# DM_BASE_URL=
# DM_JSON_MODE=
# DM_TIMEOUT_MS=
# DM_TEMPERATURE=
# DM_MAX_TOKENS=
# ZHIHU_API_KEY=
# ZHIHU_ACCESS_TOKEN=
# ZHIHU_BASE_URL=
# ZHIHU_CACHE_TTL_MS=
# ZHIHU_OAUTH_APPID=        # ZHIHU_OAUTH_APP_ID 的旧别名，仍在代码里兼容

# ===========================================================================
# D. 调试（生产保持关闭）
# ===========================================================================
# 给 /api/dm 注入人工延迟（毫秒），用于验证加载动效。**生产必须留空或 0。**
DM_DEBUG_DELAY_MS=

# ===========================================================================
# E. 站点公开地址（建议填）
# ===========================================================================
# 只用于分享卡（Open Graph 封面）的**绝对 URL** 生成，不影响运行。
# 不填会回落到 src/app/layout.tsx 的默认值；换域名时改这里，不必动代码。
# 不配的后果很隐蔽：微信 / 飞书抓取分享链接时拿不到封面，退化成纯文字链接。
# 说明：对外入口统一用 `:8443`。已知代价是微信内置浏览器对非标端口限制较严；
#      标准 443 上同一个应用与同一张证书早已就绪，需要微信直开时改这一行即可。
NEXT_PUBLIC_SITE_URL=https://zhihu.xuanyi888.cloud:8443

# 说明：容器运行所需的 NODE_ENV / HOSTNAME / PORT / NEXT_TRUST_PROXY / MEMORY_DIR
# 由 docker-compose.yml 的 environment 段注入，不需要在这里重复填写。
# 落盘目录（记忆 / 设置 / 会话 / 现实记忆 / 检索缓存）都在挂载卷 /app/data 下，
# 因此上面 C/D 段无需再指定 *_DIR。
